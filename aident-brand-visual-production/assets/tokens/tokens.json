{
  "schema_version": 2,
  "status": "starter-defaults",
  "label": "default — brand-agnostic starters; override per brand via payload or CSS custom properties",
  "overridable": true,
  "typography": {
    "fontFamilies": {
      "primary": "Outfit",
      "display": "Smiley Sans",
      "stacks": {
        "primary": "\"Outfit\", \"Inter\", system-ui, -apple-system, sans-serif",
        "display": "\"Smiley Sans\", \"Outfit\", \"Noto Sans SC\", system-ui, sans-serif"
      }
    },
    "weights": {
      "regular": 400,
      "semibold": 600
    },
    "roles": {
      "display": { "family": "primary", "weight": 600, "sizePxRange": [96, 150] },
      "headline": { "family": "primary", "weight": 600, "sizePxRange": [56, 96] },
      "body": { "family": "primary", "weight": 400, "sizePxRange": [24, 40] },
      "caption": { "family": "primary", "weight": 400, "sizePxRange": [16, 24] }
    },
    "cssVariables": {
      "primary": "--font-primary",
      "display": "--font-display",
      "weightRegular": "--font-weight-regular",
      "weightSemibold": "--font-weight-semibold"
    },
    "overridePath": "assets/fonts/ — see licenses/README.md; host-install Outfit; optional local @font-face only with license"
  },
  "sizes": {
    "videoCover": { "w": 1920, "h": 1080, "templateId": "tpl-video-cover", "html": "assets/templates/html/video-cover.html" },
    "featurePoster": { "w": 1242, "h": 1660, "templateId": "tpl-feature-poster", "html": "assets/templates/html/feature-poster.html" },
    "webBanner": { "w": 1270, "h": 760, "templateId": "tpl-banner", "html": "assets/templates/html/banner.html" },
    "xBanner": { "w": 2048, "h": 900, "templateId": "tpl-x-banner", "html": "assets/templates/html/x-banner.html" },
    "youtubeBanner": { "w": 2048, "h": 1152, "templateId": "tpl-youtube-banner", "html": "assets/templates/html/youtube-banner.html" },
    "linkedinBanner": { "w": 2048, "h": 400, "templateId": "tpl-linkedin-banner", "html": "assets/templates/html/linkedin-banner.html" },
    "profileAvatar": { "w": 400, "h": 400, "templateId": "tpl-profile-avatar", "html": "assets/templates/html/profile-avatar.html" },
    "logoMark": { "w": 80, "h": 80, "templateId": "tpl-logo-mark", "html": "assets/templates/html/logo-mark.html" },
    "logoLockup": { "wMin": 257, "wMax": 365, "h": 80, "templateId": "tpl-logo-lockup", "widthBehavior": "hug", "html": "assets/templates/html/logo-lockup.html" },
    "videoFrames": { "w": 1920, "h": 1080, "spec": "assets/templates/video-frame-specs.json", "note": "Ten storyboard stills. Pick the id that matches the beat. tpl-video-frame-16x9 is an alias of tpl-video-frame-title. A still is not an MP4." }
  },
  "spacing": {
    "safeMarginRatio": 0.06,
    "logoClearspaceMark": "0.25x mark height",
    "scale": {
      "2xs": 4,
      "xs": 8,
      "sm": 12,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64
    },
    "cssVariables": {
      "safeMarginRatio": "--safe-margin-ratio",
      "logoClearspaceRatio": "--logo-clearspace-ratio"
    }
  },
  "color": {
    "note": "Defaults below are labeled starters — NEVER treat as a frozen client brand. Swap via brand payload colors or CSS vars. Prefer pack brief approved_colors when present.",
    "roles": {
      "bg": { "value": "#0F091D", "css": "--color-bg", "status": "default" },
      "surface": { "value": "#1A1430", "css": "--color-surface", "status": "default" },
      "surfaceElevated": { "value": "rgba(255,255,255,0.06)", "css": "--color-surface-elevated", "status": "default" },
      "text": { "value": "#FFFFFF", "css": "--color-text", "status": "default" },
      "textSecondary": { "value": "rgba(255,255,255,0.78)", "css": "--color-text-secondary", "status": "default" },
      "muted": { "value": "rgba(255,255,255,0.55)", "css": "--color-muted", "status": "default" },
      "accent": { "value": "#4C5CFF", "css": "--color-accent", "status": "default" },
      "accentSoft": { "value": "#1EEAEA", "css": "--color-accent-soft", "status": "default" },
      "border": { "value": "rgba(255,255,255,0.14)", "css": "--color-border", "status": "default" }
    }
  },
  "htmlTemplates": {
    "dir": "assets/templates/html",
    "sharedTokensCss": "assets/templates/html/tokens.css",
    "slotContract": "references/editable-slots.md",
    "renderScript": "scripts/render_html_template.py"
  }
}
